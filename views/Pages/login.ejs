            <% } %>
            <form action="/login" method="post">
            <input name="email" placeholder="existing email abdulrafay.8207@gmail.com" type="email" /> <br> <br>
            <input name="password" placeholder="existing password rafay123" type="password" />
            <a id="account" href="./signin">Don't have an account?</a> <br> <br>
            <button type="submit">Login</button>
            </form>
        </div>
    </div>
</body>

</html>